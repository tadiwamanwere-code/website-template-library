  },
  "adjust": {
    "accent": {
      "label": "Accent",
      "var": "acc",
      "also": {
        "acc-hi": "color-mix(in srgb, {} 66%, #fff)",
        "acc-lo": "color-mix(in srgb, {} 74%, #000)"
      }
    },
    "fg": {
      "label": "Text",
      "var": "fg",
      "also": {
        "mut": "color-mix(in srgb, {} 56%, #fff)"
      }
    },
    "paper": {
      "label": "Page background",
      "var": "paper",
      "also": {
        "paper-2": "color-mix(in srgb, {} 96%, #000)",
        "paper-3": "color-mix(in srgb, {} 90%, #000)"
      }
    },
    "ink": {
      "label": "Dark blocks",
      "var": "ink",
      "also": {
        "ink-2": "color-mix(in srgb, {} 94%, #fff)",
        "ink-3": "color-mix(in srgb, {} 88%, #fff)",
        "ink-4": "color-mix(in srgb, {} 80%, #fff)"
      }
    }
  },
  "_brandTokens": "Words belonging to this template, not to a client.",
