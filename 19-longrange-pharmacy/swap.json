  "adjust": {
    "accent": {
      "label": "Accent",
      "var": "green",
      "also": {
        "green-d": "color-mix(in srgb, {} 74%, #000)",
        "green-l": "color-mix(in srgb, {} 62%, #fff)",
        "navy-900": "color-mix(in srgb, {} 66%, #000)"
      }
    },
    "pine": {
      "label": "Headings",
      "var": "pine",
      "also": {
        "pine-7": "color-mix(in srgb, {} 84%, #fff)",
        "pine-9": "color-mix(in srgb, {} 76%, #000)"
      }
    },
    "ink": {
      "label": "Body text",
      "var": "ink",
      "also": {
        "muted": "color-mix(in srgb, {} 64%, #fff)"
      }
    },
    "sheet": {
      "label": "Page background",
      "var": "sheet"
    },
    "ground": {
      "label": "Section bands",
      "var": "ground",
      "also": {
        "ground-2": "color-mix(in srgb, {} 99%, #000)",
        "paper-2": "color-mix(in srgb, {} 97%, #000)"
      }
    },
    "coral": {
      "label": "Sale flashes",
      "var": "coral",
      "also": {
        "coral-d": "color-mix(in srgb, {} 86%, #000)",
        "coral-soft": "color-mix(in srgb, {} 14%, #fff)"
      }
    },
    "line": {
      "label": "Lines",
      "var": "line",
      "also": {
        "line-2": "color-mix(in srgb, {} 88%, #000)"
      }
    }
  },
  "_brandTokens": "Words belonging to this template, not to a client.",
  "brandTokens": [
    "Long Range",
    "Long&nbsp;Range",
    "longrangepharmacies",
    "Bright Health",
    "Graniteside",
    "Shawasha"
  ],
  "swaps": [
    {
      "key": "BRAND_A",
      "find": "text-[25px] sm:text-[28px] text-ink\">long",
      "format": "text-[25px] sm:text-[28px] text-ink\">{}",
      "label": "Wordmark, first part",
      "maxChars": 12,
      "required": true,
      "hint": "The design sets the wordmark in two colours. This half is dark."
    },
    {
      "key": "BRAND_B",
      "find": "<span class=\"text-primary\">range</span>",
      "format": "<span class=\"text-primary\">{}</span>",
      "label": "Wordmark, second part",
      "maxChars": 12,
      "hint": "This half is in the accent colour."
    },
    {
      "key": "SHORT_TRADE",
      "find": ">Pharmacy</span>",
      "format": ">{}</span>",
      "label": "The word under the wordmark",
      "maxChars": 16
    },
    {
      "key": "BUSINESS_NAME",
      "find": "Long&nbsp;Range <span class=\"text-primary\">Pharmacies</span>",
      "format": "{}",
      "label": "Business name",
      "maxChars": 30,
      "required": true
    },
    {
      "key": "BUSINESS_NAME_PLURAL",
      "find": "Long Range Pharmacies",
      "label": "Business name in the small print",
      "maxChars": 34
    },
    {
      "key": "ABOUT",
      "find": "Skin care, baby and child care, sports nutrition, vitamins and everyday personal care. Genuine stock, priced fairly, and checked over the counter by a qualified pharmacist.",
