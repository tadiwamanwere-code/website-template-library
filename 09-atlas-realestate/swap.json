  },
  "swatchKeys": {
    "accent": "accent",
    "ink": "ink",
    "paper": "sand"
  },
  "adjust": {
    "accent": {
      "label": "Accent",
      "var": "accent"
    },
    "ink": {
      "label": "Text",
      "var": "ink",
      "also": {
        "ink-2": "color-mix(in srgb, {} 78%, #fff)",
        "ink-3": "color-mix(in srgb, {} 54%, #fff)"
      }
    },
    "paper": {
      "label": "Page background",
      "var": "sand",
      "also": {
        "bone": "color-mix(in srgb, {} 94%, #000)",
        "clay": "color-mix(in srgb, {} 86%, #000)"
      }
    },
    "line": {
      "label": "Lines",
      "var": "line"
    }
  },
  "_brandTokens": "Words belonging to this template, not to a client.",
  "brandTokens": [
    "Campo Alto",
    "Atlas Residential",
    "Príncipe Real",
    "Lisboa",
    "atlas.pt"
  ],
  "swaps": [
    {
      "key": "BUSINESS_NAME",
      "find": "Atlas Residential",
      "label": "Developer or agency name",
      "maxChars": 26,
      "required": true
    },
    {
      "key": "DEVELOPMENT",
      "find": "Campo Alto",
      "label": "Development name",
      "maxChars": 20,
      "required": true
    },
    {
      "key": "HERO_LINE_1",
      "find": "<span class=\"ln\">Campo</span>",
      "format": "<span class=\"ln\">{}</span>",
      "label": "Hero line 1 (giant type)",
      "maxChars": 12
    },
    {
      "key": "HERO_LINE_2",
