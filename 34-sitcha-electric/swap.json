    },
    "ink": {
      "label": "Text",
      "var": "ink",
      "also": {
        "ink-2": "color-mix(in srgb, {} 82%, #fff)"
      }
    },
    "sheet": {
      "label": "Page background",
      "var": "sheet"
    },
    "paper": {
      "label": "Section bands",
      "var": "paper"
    },
    "dark": {
      "label": "Dark blocks",
      "var": "dark"
    }
  },
