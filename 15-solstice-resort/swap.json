  "swatchKeys": {
    "accent": "accent",
    "ink": "ink",
    "paper": "bone"
  },
  "adjust": {
    "accent": {
      "label": "Accent",
      "var": "accent"
    },
    "ink": {
      "label": "Text and dark blocks",
      "var": "ink",
      "also": {
        "ink-2": "color-mix(in srgb, {} 88%, #fff)",
        "ink-3": "color-mix(in srgb, {} 66%, #fff)"
      }
    },
    "paper": {
      "label": "Page background",
      "var": "bone",
      "also": {
        "bone-2": "color-mix(in srgb, {} 93%, #000)"
      }
    },
    "sand": {
      "label": "Warm blocks",
      "var": "sand",
      "also": {
        "sand-2": "color-mix(in srgb, {} 80%, #000)"
      }
    }
  },
